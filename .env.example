# From developer.apple.com > Certificates, IDs & Profiles > Identifiers > Pass Type IDs
PASS_TYPE_ID=pass.com.example.giftcards
# Your 10-character Apple Developer Team ID (top-right of the developer portal)
TEAM_ID=ABCDE12345
ORG_NAME=GiftPass
# Only if you exported signerKey.pem with a passphrase
SIGNER_KEY_PASSPHRASE=
PORT=3000
# Certificates: either put wwdr.pem, signerCert.pem, signerKey.pem in ./certs (local),
# or set these (raw PEM text or base64 of the file). Vercel uses these.
WWDR_PEM=
SIGNER_CERT_PEM=
SIGNER_KEY_PEM=
